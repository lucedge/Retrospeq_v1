{
  "name": "retrospeq-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:import-boundaries": "depcruise --config .dependency-cruiser.cjs lib/analytics",
    "prepare": "git config core.hooksPath .githooks || true",
    "check": "node scripts/ledger-check.mjs && npx tsc --noEmit && eslint . && vitest run --exclude \"**/*.live.test.ts\" --exclude \"**/analytics-registry-schema.independent-verify.rls.test.ts\" && npm run test:exclusive",
    "check:live": "vitest run live.test",
    "check:security": "vitest run rls.test service-role-inventory eslint-boundary --exclude \"**/analytics-registry-schema.independent-verify.rls.test.ts\" && npm run test:exclusive && npm run check:import-boundaries && node scripts/security-grep.mjs",
    "verify": "node scripts/verify.mjs",
    "classify": "node scripts/classify-change.mjs",
    "test:user": "node --env-file=.env.local scripts/test-user.mjs",
    "e2e": "playwright test",
    "e2e:changed": "node scripts/e2e-for-change.mjs",
    "test:exclusive": "vitest run -c vitest.exclusive.config.ts",
    "docs:build": "node scripts/build-docs-site.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "decimal.js": "^10.6.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "fast-check": "^4.9.0",
    "marked": "^18.0.13",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}

# Copy to .env.local and fill in. See docs/adr/0002-shared-dev-supabase-project.md
# for why this currently points at a shared dev/test project, not a
# dedicated one.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection - required to apply migrations and run
# RLS verification, distinct from the API keys above.
# SUPABASE_DB_URL=

# Retrospeq's own envelope-encryption master key reference (external KMS).
# Do not point this at a simple static key - see AGENTS.md "Security bar."
# RETROSPEQ_KMS_KEY_ID=

# Copy to .env.local and fill in with your own Supabase project's values
# (docs/adr/0045-own-supabase-project-and-vercel-environments.md — this
# repo no longer borrows a shared project, ADR 0002 is superseded).
# Full explanation of every variable below, including the legacy-vs-new
# Supabase key pairs: docs/handbook/02-getting-started.md.

# --- Required ---------------------------------------------------------

# Supabase project URL + anon key, used by the browser and server Auth
# clients (lib/supabase/client.ts / server.ts) for sign-up/sign-in/
# session only. The `retrospeq` schema is NOT reachable this way — see
# "Direct Postgres access" in docs/DEVELOPMENT.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same project URL and the legacy service_role key, read server-side only
# by lib/supabase/service.ts for privileged/background work that
# bypasses RLS. SUPABASE_URL is typically identical to
# NEXT_PUBLIC_SUPABASE_URL above; kept as its own var so nothing
# server-only ships in the browser bundle by naming convention alone.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string — every read/write to the
# `retrospeq` schema goes through this (lib/supabase/direct.ts), since
# that schema isn't exposed to PostgREST. Use the SESSION POOLER
# connection string from the project's Database Settings, not the
# direct/IPv6 host (that endpoint has hung for 15+ minutes in practice —
# see lib/supabase/direct.ts's header comment).
SUPABASE_DB_URL=

# --- Optional -----------------------------------------------------------

# Retrospeq's own envelope-encryption master key reference (external KMS).
# Do not point this at a simple static key - see AGENTS.md "Security bar."
# No real KMS is wired up yet, so setting this has no effect either way —
# every credentialed broker connect/sync fails loudly with
# KmsNotConfiguredError regardless (docs/infra-gaps.md).
# RETROSPEQ_KMS_KEY_ID=

# Opt-in flag for lib/entitlements/dev-tools-guard.ts's dev-only plan
# override tool (flips a test user's plan without a real billing
# provider). Deliberately off by default - see that file's own header
# comment for why NODE_ENV alone isn't a strong enough gate for
# something that writes through the service role. Leave unset/commented
# unless you're actively exercising the entitlement engine locally.
# RETROSPEQ_ENABLE_DEV_ENTITLEMENT_TOOLS=true

# Sibling flag for lib/privacy/dev-tools-guard.ts's dev-only privacy/
# erasure test tooling. Several lib/privacy/__tests__/*.live.test.ts
# files set this themselves for the duration of one test; you only need
# it yourself if exercising those dev tools interactively.
# RETROSPEQ_ENABLE_DEV_PRIVACY_TOOLS=true

# Dev/test-only rate-limit bypass for the E2E suite (docs/adr/0042). Set
# by playwright.config.ts's webServer for a server IT starts; if you run
# `next dev` yourself and then the E2E suite, export it in that shell.
# Ignored when NODE_ENV=production. Leave unset for normal development.
# RETROSPEQ_E2E_RATE_LIMIT_BYPASS=true

# Transactional email (lib/privacy/email-provider.ts, 00-foundation §10).
# Resend API key + verified "From" address (sender domain must be
# verified in the Resend dashboard). Both required together, or any send
# fails loudly (never a silent no-op "pretend it sent" success). This is
# NOT the same dependency as Supabase Auth's own mailer (signup/reset
# emails), which is configured on the Supabase project itself.
# RESEND_API_KEY=
# EMAIL_FROM=

# Display name for the From header on emails sent via RESEND_API_KEY.
# Defaults to "Retrospeq" if unset.
# EMAIL_FROM_NAME=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - the .example template is a safe, secret-free reference
# and should stay tracked so collaborators/cloud agents know what's needed
.env*
!.env.local.example

# vercel
.vercel

# local permission/trust settings - machine-specific, not for the cloud
# routine or collaborators to inherit automatically. .claude/agents/ (the
# job descriptions) stays tracked; only the settings files are ignored.
.claude/settings.json
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# ephemeral screenshots agents take against the local dev server to
# visually self-check UI slices (see AGENTS.md "UI self-verification") -
# throwaway, never a build artifact to commit
/tmp/dev-screenshots
